#include <stdio.h>

int main() {
    int i, num, odd_sum = 0, even_sum = 0;

    printf("enter the value of num: ");
    scanf("%d", &num);

    for(i = 1; i <= num; i++) 
    {
        if(i % 2 == 0)
            even_sum = even_sum + i;
        else
            odd_sum = odd_sum + i;
    }

    printf("sum of even numbers = %d\n", even_sum);
    printf("sum of odd numbers = %d\n", odd_sum);

    return 0;
}